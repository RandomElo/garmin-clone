<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the emulator reaches the computer at 10.0.2.2, which lets a fake Strava server stand in for strava.home. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">strava.home</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
