# Garmin Connect account (the library logs in like the website does)
GARMIN_USERNAME=
# Quote the password if it contains # or $ (single quotes: no interpolation)
GARMIN_PASSWORD=
# garmin.com (default) or garmin.cn
GARMIN_DOMAIN=garmin.com

# true = fake data, to try the app without a Garmin account
GARMIN_MOCK=false

# Automatic sync every N minutes (0 = manual only), only inside these local-time windows (empty = all day)
SYNC_INTERVAL_MINUTES=10
SYNC_WINDOWS=10:00-12:00,18:00-22:00
# While the history is incomplete, syncs follow each other every N minutes
SYNC_CATCHUP_INTERVAL_MINUTES=2
# Activity history to sync (0 = everything on Garmin)
SYNC_ACTIVITIES_LIMIT=0
# Wellness window in days, and how much of it is caught up per sync
SYNC_WELLNESS_DAYS=365
SYNC_WELLNESS_RECENT_DAYS=3
SYNC_WELLNESS_BACKFILL_PER_RUN=30
# Activities whose laps, charts and GPS track are fetched per sync
SYNC_DETAILS_PER_RUN=60
SYNC_REQUEST_DELAY_MS=300

TZ=Europe/Paris
